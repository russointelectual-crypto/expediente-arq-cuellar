  <diagram id="kjWQZq80cx4jK8_EtijI" name="Página-1">
    <mxGraphModel dx="1414" dy="849" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class Usuario {\n        &lt;&lt;abstract&gt;&gt;\n        -id: int\n        -nombreCompleto: string\n        -usuario: string\n        -contraseñaHash: string\n        +iniciarSesion()\n        +cambiarContraseña()\n    }\n\n    class Gerente {\n        +registrarPersonal()\n        +editarPersonal()\n        +eliminarPersonal()\n        +modificarPrecio(producto)\n        +verIngresosEgresos()\n        +verReportesGlobales()\n    }\n\n    class Secretaria {\n        +registrarCliente(cliente)\n        +registrarEquipo(equipo)\n        +venderAccesorio(item, cantidad)\n        +entregarEquipo(orden)\n        +generarReporteCaja(fecha)\n    }\n\n    class Tecnico {\n        +diagnosticarEquipo(equipo)\n        +registrarSolucion(orden, detalle)\n        +actualizarEstadoOrden(orden, estado)\n        +usarRepuesto(repuesto, cantidad)\n    }\n\n    class Cliente {\n        -id: int\n        -nombreCompleto: string\n        -celular1: string\n        -celular2: string\n    }\n\n    class Equipo {\n        -id: int\n        -tipo: string\n        -marca: string\n        -modelo: string\n        -procesador: string\n        -ramGB: int\n        -hddGB: int\n        -ssdGB: int\n        -tipoBateria: string\n        -contraseñaEquipo: string\n        -fotoEquipo: string\n        -danosRegistrados: string\n        +registrarEstadoFisico()\n    }\n\n    class OrdenDeTrabajo {\n        -numeroRecibo: string\n        -fechaIngreso: date\n        -fechaEntrega: date\n        -motivoIngreso: string\n        -diagnostico: string\n        -solucionAplicada: string\n        -componenteCambiado: string\n        -garantia: string\n        -costo: decimal\n        -estado: string\n        +cambiarEstado(nuevoEstado)\n        +asignarTecnico(tecnico)\n        +generarRecibo()\n        +calcularCosto()\n    }\n\n    class ItemInventario {\n        &lt;&lt;abstract&gt;&gt;\n        -nombre: string\n        -marca: string\n        -modelo: string\n        -costoCompra: decimal\n        -costoVenta: decimal\n        -cantidad: int\n        -fechaIngreso: date\n        +descontarStock(cantidad)\n        +actualizarStock(cantidad)\n    }\n\n    class Repuesto\n    class Accesorio\n    class Licencia {\n        -nombreLicencia: string\n        -codigoLicencia: string\n        -usadaPor: string\n        -fechaUso: date\n        +asignarLicencia(equipo)\n    }\n\n    class Venta {\n        -fecha: date\n        -cantidad: int\n        -total: decimal\n        +registrarVenta()\n    }\n\n    class Notificacion {\n        -tipo: string\n        -destinatario: string\n        -mensaje: string\n        -fecha: date\n        +enviarAviso()\n    }\n\n    class Reporte {\n        -tipo: string\n        -periodo: string\n        -generadoPor: string\n        +generar()\n    }\n\n    Usuario &lt;|-- Gerente\n    Usuario &lt;|-- Secretaria\n    Usuario &lt;|-- Tecnico\n\n    ItemInventario &lt;|-- Repuesto\n    ItemInventario &lt;|-- Accesorio\n\n    Cliente \&quot;1\&quot; --&gt; \&quot;*\&quot; Equipo : deja\n    Equipo \&quot;1\&quot; --&gt; \&quot;1\&quot; OrdenDeTrabajo : genera\n    OrdenDeTrabajo \&quot;*\&quot; --&gt; \&quot;1\&quot; Tecnico : asignada a\n    OrdenDeTrabajo \&quot;*\&quot; --&gt; \&quot;1\&quot; Secretaria : registrada por\n    OrdenDeTrabajo \&quot;*\&quot; --&gt; \&quot;*\&quot; Repuesto : consume\n    OrdenDeTrabajo \&quot;0..1\&quot; --&gt; \&quot;0..1\&quot; Licencia : usa\n    OrdenDeTrabajo \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Notificacion : dispara\n    Secretaria \&quot;1\&quot; --&gt; \&quot;*\&quot; Venta : registra\n    Accesorio \&quot;1\&quot; --&gt; \&quot;*\&quot; Venta : vendido en\n    Gerente \&quot;1\&quot; --&gt; \&quot;*\&quot; Reporte : solicita\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="144">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
